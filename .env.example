# ==============================================================================
# Kitchome RAG Intelligence Platform - Environment Configuration (.env.example)
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Network Service Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# FastAPI Backend Service
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8000

# Streamlit UI Port
STREAMLIT_SERVER_PORT=8501

# Upstream Identity Provider Service (Complete-custom-auth)
AUTH_SERVICE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Perimeter Configuration
# ------------------------------------------------------------------------------
# Shared secret for signing & verifying JWT tokens issued by upstream auth service.
# Supports plain text secret or Base64-encoded secret keys.
AUTH_JWT_SECRET=your_jwt_secret_key_here

# ------------------------------------------------------------------------------
# 3. Local Databases & Storage Paths
# ------------------------------------------------------------------------------
SERVICE_SCOPES_DB_PATH=data/service_scopes.db
INGESTION_HISTORY_DB_PATH=data/ingestion_history.db
VECTOR_STORE_DATA_PATH=vector_store_data.json

# ------------------------------------------------------------------------------
# 4. PostgreSQL + pgvector Storage (Production Vector Store)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kitchome_rag
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_VECTOR_TABLE=kitchome_vector_chunks

# ------------------------------------------------------------------------------
# 5. Embedding Engine Configuration
# ------------------------------------------------------------------------------
# Supported providers: 'hash' (default for offline/testing), 'huggingface', 
# 'huggingface_api', 'ollama', 'openai', 'fastembed'
EMBEDDER_PROVIDER=hash
EMBEDDER_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDER_DIMENSION=384
EMBEDDER_BATCH_SIZE=32
EMBEDDER_DEVICE=cpu
EMBEDDER_BASE_URL=http://localhost:11434

# Cloud API Tokens (Optional - populate only if using cloud inference providers)
HF_TOKEN=your_huggingface_token_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 6. Ingestion Pipeline & Distributed Worker Daemon
# ------------------------------------------------------------------------------
WORKER_ROLE=all
WORKER_MODE=process
CHUNKER_CONCURRENCY=1
EMBEDDER_CONCURRENCY=2
EMBEDDER_BATCH_SIZE=32
WORKER_LEASE_SECONDS=120.0
EMBEDDER_LEASE_SECONDS=60.0
WORKER_POLL_INTERVAL=1.0

# Document Ingestion Chunking Parameters
INGESTION_CHUNK_SIZE=300
INGESTION_CHUNK_OVERLAP=50

# ------------------------------------------------------------------------------
# 7. Distributed Observability Stack
# ------------------------------------------------------------------------------
OBSERVABILITY_HOST=your_observability_host_or_ip
LOKI_ENABLED=true
LOKI_URL=http://your_observability_host_or_ip:3100/loki/api/v1/push
TRACING_ENABLED=true
TEMPO_OTLP_ENDPOINT=http://your_observability_host_or_ip:4318/v1/traces
METRICS_ENABLED=true

# ------------------------------------------------------------------------------
# 8. Distributed Redis Cache & Session Store
# ------------------------------------------------------------------------------
REDIS_HOST=your_redis_host_or_ip
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here
REDIS_ENABLED=true

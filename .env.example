# ==============================================================================
# Kitchome RAG Environment Variables (.env.example)
# Copy this file to .env and replace placeholder values with your real credentials.
# ==============================================================================

# Embedding Engine Configuration
EMBEDDER_PROVIDER=hash
EMBEDDER_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDER_DIMENSION=384
EMBEDDER_BATCH_SIZE=32
EMBEDDER_DEVICE=cpu
EMBEDDER_BASE_URL=http://localhost:11434

# API Keys (leave blank for local hash/sentence-transformers)
HF_TOKEN=your_huggingface_token_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL + pgvector Storage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kitchome_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Ingestion Worker Daemon
WORKER_ROLE=all
WORKER_MODE=process
CHUNKER_CONCURRENCY=1
EMBEDDER_CONCURRENCY=2
EMBEDDER_BATCH_SIZE=32
WORKER_LEASE_SECONDS=120.0
EMBEDDER_LEASE_SECONDS=60.0
WORKER_POLL_INTERVAL=1.0
